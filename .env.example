# Demo talep bildirimleri — Resend (https://resend.com)
# Bu üçü tanımlı değilse talepler yalnızca sunucu günlüğüne yazılır.

# Resend panelinden alınan API anahtarı
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Taleplerin düşeceği adres. Birden fazla için virgülle ayırın.
DEMO_NOTIFY_TO=demo@dentasist.com

# Gönderen adres — Resend'de doğrulanmış alan adınızdan olmalı.
DEMO_NOTIFY_FROM=Dentasist <bildirim@dentasist.com>
