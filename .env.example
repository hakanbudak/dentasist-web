# Demo talep bildirimleri — Resend (https://resend.com)
# Kopyalayıp .env.local olarak kaydedin. Bu üçü tanımlı değilse talepler
# gönderilmez, yalnızca sunucu günlüğüne yazılır.

# Resend panelindeki API Keys bölümünden alınır.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Taleplerin düşeceği adres. Birden fazla için virgülle ayırın.
DEMO_NOTIFY_TO=talep@ornek.com

# Gönderen adres. Test için Resend'in hazır adresi kullanılabilir:
#   DEMO_NOTIFY_FROM=Dentasist <onboarding@resend.dev>
# Ancak bu adres yalnızca Resend hesabının sahibine mail gönderebilir.
# Yayında doğrulanmış kendi alan adınızı kullanın.
DEMO_NOTIFY_FROM=Dentasist <bildirim@ornek.com>
